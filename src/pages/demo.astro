---
// /demo — clone of heymarket.com/demo ("See Heymarket in action").
// Copy, imagery, and measurements sourced from heymarket.com/demo, including
// its responsive behaviour (Bootstrap breakpoints 576/768/992/1200 → Tailwind
// sm/md/lg/xl).
// NOTE: the booking form is not wired to HubSpot / the scheduler; it validates
// locally and shows a preview notice instead of submitting anywhere.
import Base from "../layouts/Base.astro";

const A = "/heymarket-website/assets";

const avatars = [
  { src: `${A}/demo-avatar-craig.webp`, alt: "Craig, Heymarket product specialist" },
  { src: `${A}/demo-avatar-gracie.webp`, alt: "Gracie, Heymarket product specialist" },
  { src: `${A}/demo-avatar-josh.webp`, alt: "Josh, Heymarket product specialist" },
];

// Same set as the heymarket.com homepage. Phones: 3 on the first row, 2 on the
// second. From 768px (tablet) up: one row.
const logos = [
  { src: `${A}/demo-logo-kisco.webp`, alt: "KISCO Senior Living", w: 283 },
  { src: `${A}/demo-logo-uhaul.webp`, alt: "U-Haul", w: 231 },
  { src: `${A}/demo-logo-crst.webp`, alt: "CRST", w: 183 },
  { src: `${A}/demo-logo-methodology.webp`, alt: "Methodology", w: 276 },
  { src: `${A}/demo-logo-weyerhaeuser.webp`, alt: "Weyerhaeuser", w: 472 },
];

type Story = {
  tag: string; tagBg: string; logo: string; logoAlt: string; logoW: number; logoH: number;
  stat: string; statColor: string; label: string; quote: string;
};
const stories: Story[] = [
  {
    tag: "Healthcare", tagBg: "#ffefbe",
    logo: `${A}/demo-case-smile.webp`, logoAlt: "Smile Specialist Dental Clinics", logoW: 70, logoH: 64,
    stat: "50%", statColor: "#ffc926", label: "appointment book rate through text",
    quote: "We love Heymarket. It’s great having a separate inbox for customer conversations. It’s easy to keep clear. And bookings have increased!",
  },
  {
    tag: "Dispatch and operations", tagBg: "#bbb3e8",
    logo: `${A}/demo-case-budget.webp`, logoAlt: "Budget Dumpster", logoW: 220, logoH: 33,
    stat: "13 sec", statColor: "#1b02b1", label: "hold time decrease YOY",
    quote: "Heymarket was the upgrade that we weren’t proactively seeking but that we really needed.",
  },
  {
    tag: "Retail", tagBg: "#f5d2c8",
    logo: `${A}/demo-case-adorn.webp`, logoAlt: "Adorn Bridal", logoW: 150, logoH: 62,
    stat: "50%", statColor: "#e8542c", label: "time saved during store visits",
    quote: "I have three screens up at all times. Heymarket is one of them. It’s added a lot of ease to our job.",
  },
];

// Booking form options, same order as the live heymarket.com/demo HubSpot form.
const countries = ["United States", "Canada", "Other"];
const features = ["SMS", "Email", "AI agents", "Integrations", "Shared inbox", "Automations", "Compliance"];

// Shared field classes (HubSpot-style: 43px inputs, #cfcfcf border, yellow focus).
const fieldCls = "block w-full rounded-lg border border-[#cfcfcf] bg-paper px-[15px] py-2 text-base leading-6 text-ink outline-none transition-colors focus:border-[#ffc107]";
const labelCls = "mb-[5px] block text-sm font-semibold leading-[18px] text-ink-70";
const errCls = "field-error mt-1.5 hidden pl-2 text-xs font-semibold leading-[15px] text-[#e8542c]";
---
<Base
  title="Heymarket Demo | Try Business Text Messaging Software"
  description="See Heymarket in action. Book a free time slot for a live demo of shared inboxes and AI agents for SMS and email."
>
  <!-- Header: logo + Sign In (hamburger menu below 992px, like the live site) -->
  <header class="relative bg-paper">
    <div class="mx-auto flex h-[60px] max-w-[1210px] bs-lg:h-[70px] items-center justify-between px-[31px] bs-lg:px-5">
      <a href={import.meta.env.BASE_URL} aria-label="Heymarket home">
        <img src={`${A}/heymarket-logo-black.svg`} alt="Heymarket" width="149" height="33" class="h-7 w-auto bs-lg:h-[33px]" />
      </a>
      <a href="https://app.heymarket.com/account/login" class="text-sm font-medium leading-[18px] text-ink hover:underline bs-lg:text-base">Sign In</a>
    </div>
  </header>

  <main>
    <!-- Hero: pitch + booking form (stacked below 992px) -->
    <section class="demo-hero bg-purple py-8 text-paper bs-lg:py-16" aria-labelledby="demo-heading">
      <div class="bs grid gap-8 bs-lg:grid-cols-2 bs-lg:gap-[30px]">
        <div>
          <div class="flex gap-2.5">
            {avatars.map((a) => (
              <img src={a.src} alt={a.alt} width="75" height="75" class="h-[60px] w-[60px] rounded-full object-cover bs-lg:h-[75px] bs-lg:w-[75px]" />
            ))}
          </div>
          <h1 id="demo-heading" class="demo-h1 mt-4 font-[800]">Speak to a product specialist about your team’s messaging</h1>
          <p class="mt-4 text-lg font-medium leading-[27px]">
            A 30-minute call to learn how shared inboxes and AI agents for SMS and email fit your use case.
          </p>
        </div>

        <div>
          <form id="book-demo" class="demo-form mx-auto rounded-3xl border border-ink bg-paper p-6 text-ink md:max-w-[580px] bs-lg:max-w-none" novalidate>
            <h2 class="fs-24-32 text-center font-[800] leading-[1.2]">Book a free time slot</h2>

            <!-- Step 1: business email. The rest of the form expands once it's a valid address. -->
            <div class="mt-[34px]" data-field="email">
              <label for="demo-email" class={labelCls}>Business email<span class="text-[#f2545b]">*</span></label>
              <input id="demo-email" name="email" type="email" required autocomplete="email" class={`${fieldCls} h-[43px]`} aria-describedby="demo-email-err" />
              <p id="demo-email-err" class={errCls} role="alert"></p>
            </div>

            <!-- Step 2: revealed after a valid email (like the live HubSpot form) -->
            <div class="demo-more" hidden>
              <div class="mt-[18px] grid gap-[18px] min-[480px]:grid-cols-2 min-[480px]:gap-x-1">
                <div data-field="firstname">
                  <label for="demo-first" class={labelCls}>First name<span class="text-[#f2545b]">*</span></label>
                  <input id="demo-first" name="firstname" type="text" required autocomplete="given-name" class={`${fieldCls} h-[43px]`} aria-describedby="demo-first-err" />
                  <p id="demo-first-err" class={errCls} role="alert"></p>
                </div>
                <div data-field="lastname">
                  <label for="demo-last" class={labelCls}>Last name<span class="text-[#f2545b]">*</span></label>
                  <input id="demo-last" name="lastname" type="text" required autocomplete="family-name" class={`${fieldCls} h-[43px]`} aria-describedby="demo-last-err" />
                  <p id="demo-last-err" class={errCls} role="alert"></p>
                </div>
              </div>

              <div class="mt-[18px]" data-field="phone">
                <label for="demo-phone" class={labelCls}>Mobile (for text reminders)</label>
                <input id="demo-phone" name="phone" type="tel" autocomplete="tel" class={`${fieldCls} h-[43px]`} aria-describedby="demo-phone-err" />
                <p id="demo-phone-err" class={errCls} role="alert"></p>
              </div>

              <div class="mt-[18px]" data-field="country">
                <label for="demo-country" class={labelCls}>Country<span class="text-[#f2545b]">*</span></label>
                <select id="demo-country" name="country_dropdown" required class={`${fieldCls} demo-select h-[43px] appearance-none pr-10`} aria-describedby="demo-country-err">
                  <option value="">Please Select</option>
                  {countries.map((c) => <option value={c}>{c}</option>)}
                </select>
                <p id="demo-country-err" class={errCls} role="alert"></p>
              </div>

              <fieldset class="mt-[18px]">
                <legend class={labelCls}>Which features or integrations would you like to see?</legend>
                <div class="flex flex-wrap gap-2">
                  {features.map((f) => (
                    <label class="cursor-pointer">
                      <input type="checkbox" name="features" value={f} class="peer sr-only" />
                      <span class="inline-flex select-none items-center rounded-full border border-[#cfcfcf] bg-paper px-4 py-1.5 text-sm font-semibold leading-[18px] text-ink-70 transition-colors hover:border-purple peer-checked:border-purple peer-checked:bg-purple peer-checked:text-paper peer-focus-visible:ring-2 peer-focus-visible:ring-purple/40">{f}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="mt-[14px] flex cursor-pointer items-start gap-4">
                <input name="sms_opt_in" type="checkbox" class="mt-px h-[14px] w-[14px] shrink-0 accent-purple" />
                <span class="text-[10px] font-semibold leading-[14px] text-ink-70">
                  I agree to receive SMS messages from Heymarket regarding appointment reminders, confirmations, and
                  scheduling follow-ups. Message frequency varies. Message and data rates may apply. Reply HELP for help
                  or STOP to cancel. View our <a href="https://www.heymarket.com/tos/" class="text-ink" target="_blank" rel="noopener">Terms of Service</a>
                  and <a href="https://www.heymarket.com/privacy/" class="text-ink" target="_blank" rel="noopener">Privacy Policy</a>.
                </span>
              </label>
            </div>

            <button
              type="submit"
              class="mt-6 w-full rounded bg-yellow px-6 py-4 text-base font-[800] uppercase leading-[18px] tracking-[1.6px] text-ink transition hover:brightness-95"
            >Pick your time</button>
            <p class="demo-status mt-4 hidden text-center text-sm leading-[18px] text-ink-70" role="status"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- Customer logos: one row at every width -->
    <section class="pb-12 pt-5 md:pt-12" aria-label="Customers">
      <ul class="bs flex flex-wrap items-center justify-center gap-x-6 gap-y-3 md:flex-nowrap md:gap-4 bs-lg:gap-[30px] bs-xl:justify-between bs-xl:px-[61px]">
        {logos.map((l, i) => (
          <>
            <li>
              <img src={l.src} alt={l.alt} width={l.w / 2} height="70" class="h-[min(56px,calc((100vw-78px)/5))] w-auto max-w-none bs-sm:h-[60px] md:h-[clamp(57px,calc(7.56vw-1px),70px)] bs-lg:h-[70px]" />
            </li>
            {i === 2 && <li class="h-0 basis-full md:hidden" aria-hidden="true"></li>}
          </>
        ))}
      </ul>
    </section>

    <!-- Proof: U-Haul stat + quote (centred and stacked below 992px) -->
    <section class="bg-[#e1d7fb] py-[60px]" aria-label="Customer result">
      <div class="bs">
        <figure class="grid items-center gap-8 rounded-[40px] bg-paper px-5 py-10 text-center shadow-[0_16px_50px_0_rgba(0,0,0,0.1)] md:p-10 bs-lg:grid-cols-[225px_1fr] bs-lg:gap-12 bs-lg:p-[60px] bs-lg:text-left">
          <div class="text-center">
            <p class="text-[100px] font-[800] leading-none text-blue">60%</p>
            <p class="mt-2 text-lg font-semibold leading-[27px]">response rate achieved</p>
          </div>
          <div>
            <img src={`${A}/demo-quote-uhaul.webp`} alt="U-Haul" width="115" height="66" class="mx-auto h-auto w-[115px] bs-lg:mx-0" />
            <blockquote class="fs-24-32 mt-2 font-semibold leading-[1.2]">
              “Heymarket’s Salesforce SMS integration makes messaging leads and customers a
              <span class="text-blue">smooth experience</span> for our agents.”
            </blockquote>
          </div>
        </figure>
      </div>
    </section>

    <!-- Customer stories (stacked below 992px; 30px kept free on the right for the label tabs) -->
    <section class="bg-beige py-[50px]" aria-labelledby="stories-heading">
      <div class="bs">
        <h2 id="stories-heading" class="fs-24-32 text-center font-[800] leading-[1.2]">
          In the meantime, check out how some of our customers are connecting with their customers with Heymarket
        </h2>
        <div class="mt-10 grid gap-[30px] pr-[30px] bs-lg:grid-cols-3 bs-lg:gap-[60px]">
          {stories.map((s) => (
            <article class="story-card relative flex flex-col bg-paper px-8 pb-16 pt-[58px]">
              <span class="story-tag" style={`background:${s.tagBg}`}>{s.tag}</span>
              <img src={s.logo} alt={s.logoAlt} width={s.logoW} height={s.logoH} class="h-auto self-start" style={`width:${s.logoW}px`} />
              <p class="fs-40-56 mt-4 font-[800] leading-[1.2]" style={`color:${s.statColor}`}>{s.stat}</p>
              <p class="mt-1 text-base font-semibold leading-6">{s.label}</p>
              <p class="mt-4 flex-1 text-base leading-6">“{s.quote}”</p>
              <a href="#" class="group mt-8 inline-flex items-center gap-1 text-base font-semibold leading-6 text-blue">
                Read the story
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-purple py-20 text-center text-paper" aria-labelledby="demo-cta-heading">
      <h2 id="demo-cta-heading" class="bs fs-32-40 font-[800] leading-[1.2]">Grow connections and conversions</h2>
      <a
        href="#book-demo"
        class="mt-8 inline-block rounded bg-yellow px-6 py-4 text-base font-[800] uppercase leading-[18px] text-ink transition hover:brightness-95"
      >Book a demo</a>
    </section>
  </main>

  <!-- Footer: stacked on phones, two rows on tablets, one row from 992px -->
  <footer class="bg-ink p-6 text-base leading-6 text-[#b3b3b3]">
    <div class="mx-auto flex max-w-[1110px] flex-col items-center gap-3 text-center md:flex-row md:flex-wrap md:justify-center md:gap-x-16 bs-lg:flex-nowrap bs-lg:justify-between">
      <div class="flex flex-col gap-3 md:flex-row md:gap-6">
        <a href="https://www.heymarket.com/tos/" class="hover:text-paper">Terms of Service</a>
        <a href="https://www.heymarket.com/privacy/" class="hover:text-paper">Privacy Policy</a>
      </div>
      <p class="md:order-last md:w-full bs-lg:order-none bs-lg:w-auto">© {new Date().getFullYear()} Common Sun, Inc.</p>
      <div class="flex flex-col items-center gap-3 md:flex-row md:gap-6">
        <a href="sms:+14155620500" class="inline-flex items-center gap-2 whitespace-nowrap hover:text-paper">
          <img src={`${A}/demo-footer-chat.svg`} alt="" width="23" height="17" /> (415) 562-0500
        </a>
        <a href="mailto:sales@heymarket.com" class="inline-flex items-center gap-2 whitespace-nowrap hover:text-paper">
          <img src={`${A}/demo-footer-email.svg`} alt="" width="24" height="24" /> sales@heymarket.com
        </a>
      </div>
    </div>
  </footer>
</Base>

<style>
  /* heymarket.com sets the whole page in the device system font. */
  :global(body) {
    font-family: -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  /* Bootstrap-equivalent container, matching heymarket.com's breakpoints. */
  .bs { width: 100%; margin-inline: auto; padding-inline: 15px; }
  @media (min-width: 575px) { .bs { max-width: 540px; } }
  @media (min-width: 768px) { .bs { max-width: 720px; } }
  @media (min-width: 992px) { .bs { max-width: 1028px; } }
  @media (min-width: 1200px) { .bs { max-width: 1140px; } }

  /* Fluid type, fitted to the live site's sizes at 375px and 1200px. */
  .fs-24-32 { font-size: clamp(1.5rem, 1.2727rem + 0.9697vw, 2rem); }
  .fs-32-40 { font-size: clamp(2rem, 1.7727rem + 0.9697vw, 2.5rem); }
  .fs-40-56 { font-size: clamp(2.5rem, 2.0455rem + 1.9394vw, 3.5rem); }
  .demo-h1 { font-size: 2rem; line-height: 1.25; }
  @media (min-width: 992px) {
    .demo-h1 { font-size: clamp(2.5rem, 2.0455rem + 1.9394vw, 3.5rem); line-height: 1.2; }
  }

  .demo-hero { border-radius: 0; } /* phones: square corners */
  @media (min-width: 768px) { .demo-hero { border-radius: 60px 60px 10px 60px; } } /* tablet: rounded top too */
  @media (min-width: 992px) { .demo-hero { border-radius: 100px 100px 10px 100px; } }
  @media (min-width: 1200px) { .demo-hero { border-radius: 140px 140px 10px 140px; } }


  /* HubSpot-style select arrow. */
  .demo-select {
    background-image: url("data:image/svg+xml,%3Csvg width=%2713%27 height=%277%27 viewBox=%270 0 13 7%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cpath d=%27M6.1 6.64a1.1 1.1 0 0 0 1.5 0L12.5 1.9C13.2 1.2 12.7 0 11.7 0H1.3C.3 0-.2 1.2.5 1.9z%27 fill=%27%23000%27/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 15px center;
  }

  /* Speech-bubble story card with a tab label hanging off its top-right. */
  .story-card {
    border-radius: 40px 40px 8px 40px;
    box-shadow: 0 16px 50px 0 rgb(0 0 0 / 0.1);
  }
  .story-tag {
    position: absolute;
    top: 0;
    right: -30px;
    width: 230px;
    padding: 8px 12px;
    border-radius: 16px 16px 16px 2px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-transform: uppercase;
    color: var(--color-ink-70);
  }
</style>

<script>
  // Booking form — behaves like the live HubSpot form, but is preview-only:
  // nothing is submitted or stored. The extra fields expand once the email is a
  // valid address; required fields validate on blur and again on submit.
  const form = document.querySelector<HTMLFormElement>(".demo-form");
  const more = form?.querySelector<HTMLElement>(".demo-more");
  const status = form?.querySelector<HTMLElement>(".demo-status");

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const PHONE_RE = /^[0-9+()\-.\sxX]+$/;
  const FREE_DOMAINS = new Set([
    "gmail.com", "googlemail.com", "yahoo.com", "ymail.com", "hotmail.com", "outlook.com", "live.com", "msn.com",
    "aol.com", "icloud.com", "me.com", "mac.com", "protonmail.com", "proton.me", "gmx.com", "mail.com", "yandex.com",
    "zoho.com", "test.com",
  ]);
  const RESERVED_DOMAINS = /(^|\.)example\.(com|org|net)$|\.(test|example|invalid|localhost)$/;
  const REQUIRED = "This is a required field.";

  const emailError = (v: string): string => {
    if (!v) return REQUIRED;
    if (!EMAIL_RE.test(v)) return "Email must be formatted correctly.";
    const domain = v.split("@")[1].toLowerCase();
    if (RESERVED_DOMAINS.test(domain)) return "Please enter a valid email address.";
    if (FREE_DOMAINS.has(domain)) return `Please enter a different email address. This form does not accept addresses from ${domain}.`;
    return "";
  };

  // name → validator returning an error message ("" when valid)
  const rules: Record<string, (v: string) => string> = {
    email: emailError,
    firstname: (v) => (v ? "" : REQUIRED),
    lastname: (v) => (v ? "" : REQUIRED),
    phone: (v) => (!v || PHONE_RE.test(v) ? "" : "Must contain only numbers, +()-. and x."), // optional
    country_dropdown: (v) => (v ? "" : REQUIRED),
  };

  const control = (name: string) =>
    form?.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`) ?? null;

  const showError = (name: string, message: string) => {
    const el = control(name);
    const err = el?.id ? document.getElementById(`${el.id}-err`) : null;
    if (!el || !err) return;
    el.setAttribute("aria-invalid", String(Boolean(message)));
    err.textContent = message;
    err.classList.toggle("hidden", !message);
  };

  const validate = (name: string) => {
    const el = control(name);
    const message = el ? rules[name](el.value.trim()) : "";
    showError(name, message);
    return !message;
  };

  const reveal = () => {
    if (more?.hidden) more.hidden = false;
  };

  if (form && more && status) {
    const email = control("email") as HTMLInputElement;

    // Expand as soon as the email is a complete, well-formed address.
    email.addEventListener("input", () => {
      if (EMAIL_RE.test(email.value.trim())) reveal();
      if (email.getAttribute("aria-invalid") === "true") validate("email");
    });

    for (const name of Object.keys(rules)) {
      const el = control(name);
      el?.addEventListener("blur", () => validate(name));
      // Clear an error as soon as the user fixes the field.
      el?.addEventListener(el instanceof HTMLSelectElement ? "change" : "input", () => {
        if (el.getAttribute("aria-invalid") === "true") validate(name);
      });
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      status.classList.add("hidden");
      if (!validate("email")) { email.focus(); return; }
      if (more.hidden) { reveal(); control("firstname")?.focus(); return; }
      const invalid = Object.keys(rules).filter((name) => !validate(name));
      if (invalid.length) { control(invalid[0])?.focus(); return; }
      status.textContent = "Preview only: this form isn’t connected yet, so nothing was sent.";
      status.classList.remove("hidden");
    });
  }
</script>
