---
// /demo — clone of heymarket.com/demo ("See Heymarket in action").
// Copy, imagery, and measurements sourced from heymarket.com/demo.
// NOTE: the booking form is not wired to HubSpot / the scheduler; it validates
// locally and shows a preview notice instead of submitting anywhere.
import Base from "../layouts/Base.astro";

const A = "/heymarket-website/assets";

const avatars = [
  { src: `${A}/demo-avatar-craig.webp`, alt: "Craig, Heymarket product specialist" },
  { src: `${A}/demo-avatar-gracie.webp`, alt: "Gracie, Heymarket product specialist" },
  { src: `${A}/demo-avatar-josh.webp`, alt: "Josh, Heymarket product specialist" },
];

const checks = [
  "Tell us about your messaging needs",
  "Get expert recommendations on features",
  "Based on your use case, see a live demo on the spot\nor get set up with a specialized live demo",
  "See AI agents expediting SMS and email conversations",
];

const badges = [
  { src: `${A}/g2-leader.svg`, alt: "G2 Leader, Winter 2025" },
  { src: `${A}/g2-best-roi.svg`, alt: "G2 Best Est. ROI, Enterprise, Winter 2025" },
  { src: `${A}/g2-easiest.svg`, alt: "G2 Easiest To Use, Enterprise, Winter 2025" },
  { src: `${A}/g2-high-performer.svg`, alt: "G2 High Performer, Enterprise, Winter 2025" },
];

const logos = [
  { src: `${A}/demo-logo-kisco.webp`, alt: "KISCO Senior Living", w: 283 },
  { src: `${A}/demo-logo-uhaul.webp`, alt: "U-Haul", w: 231 },
  { src: `${A}/demo-logo-cornell.webp`, alt: "Cornell University", w: 401 },
  { src: `${A}/demo-logo-methodology.webp`, alt: "Methodology", w: 276 },
  { src: `${A}/demo-logo-budget.webp`, alt: "Budget Dumpster", w: 400 },
];

type Story = {
  tag: string; tagBg: string; logo: string; logoAlt: string; logoW: number; logoH: number;
  stat: string; statColor: string; label: string; quote: string;
};
const stories: Story[] = [
  {
    tag: "Healthcare", tagBg: "#ffefbe",
    logo: `${A}/demo-case-smile.webp`, logoAlt: "Smile Specialist Dental Clinics", logoW: 70, logoH: 64,
    stat: "50%", statColor: "#ffc926", label: "appointment book rate through text",
    quote: "We love Heymarket. It’s great having a separate inbox for customer conversations. It’s easy to keep clear. And bookings have increased!",
  },
  {
    tag: "Dispatch and operations", tagBg: "#bbb3e8",
    logo: `${A}/demo-case-budget.webp`, logoAlt: "Budget Dumpster", logoW: 220, logoH: 33,
    stat: "13 sec", statColor: "#1b02b1", label: "hold time decrease YOY",
    quote: "Heymarket was the upgrade that we weren’t proactively seeking but that we really needed.",
  },
  {
    tag: "Retail", tagBg: "#f5d2c8",
    logo: `${A}/demo-case-adorn.webp`, logoAlt: "Adorn Bridal", logoW: 150, logoH: 62,
    stat: "50%", statColor: "#e8542c", label: "time saved during store visits",
    quote: "I have three screens up at all times. Heymarket is one of them. It’s added a lot of ease to our job.",
  },
];
---
<Base
  title="Heymarket Demo | Try Business Text Messaging Software"
  description="See Heymarket in action. Book a free time slot for a live demo of shared inboxes and AI agents for SMS and email."
>
  <!-- Minimal header: logo + Sign In -->
  <header class="bg-paper">
    <div class="mx-auto flex h-[70px] max-w-[1210px] items-center justify-between px-5">
    <a href={import.meta.env.BASE_URL} aria-label="Heymarket home">
      <img src={`${A}/heymarket-logo-black.svg`} alt="Heymarket" width="149" height="33" class="h-[33px] w-auto" />
    </a>
    <a href="https://app.heymarket.com/account/login" class="text-base font-medium leading-[18px] text-ink hover:underline">Sign In</a>
    </div>
  </header>

  <main>
    <!-- Hero: pitch + booking form -->
    <section class="demo-hero bg-purple py-16 text-paper" aria-labelledby="demo-heading">
      <div class="mx-auto grid max-w-[1110px] gap-10 px-5 lg:grid-cols-2 lg:gap-[30px] lg:px-0">
        <div>
          <p class="text-lg font-bold uppercase leading-[26px]">See Heymarket in action</p>
          <div class="mt-4 flex gap-2.5">
            {avatars.map((a) => (
              <img src={a.src} alt={a.alt} width="75" height="75" class="h-[75px] w-[75px] rounded-full object-cover" />
            ))}
          </div>
          <h1 id="demo-heading" class="mt-4 text-[clamp(2.5rem,1.6rem+3vw,3.5rem)] font-[800] leading-[1.2]">
            All your messages, one shared inbox
          </h1>
          <ul class="mt-4 space-y-2">
            {checks.map((c) => (
              <li class="relative whitespace-pre-line pl-8 text-base font-semibold leading-6">
                <svg viewBox="0 0 24 24" class="absolute left-0 top-0.5 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {c}
              </li>
            ))}
          </ul>
          <ul class="mt-10 flex flex-wrap gap-4" aria-label="G2 awards">
            {badges.map((b) => (
              <li><img src={b.src} alt={b.alt} width="89" height="116" class="h-[116px] w-[89px]" /></li>
            ))}
          </ul>
        </div>

        <div class="lg:pt-0">
          <form id="book-demo" class="demo-form rounded-3xl border border-ink bg-paper p-10 text-ink" novalidate>
            <h2 class="text-center text-[length:var(--text-h3)] font-[800] leading-[1.2]">Book a free time slot</h2>
            <label for="demo-email" class="mt-[34px] block text-sm font-semibold leading-[18px] text-ink-70">
              Business email<span class="text-[#f2545b]">*</span>
            </label>
            <input
              id="demo-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-[5px] h-[43px] w-full rounded-lg border border-[#cfcfcf] px-[15px] py-2 text-base leading-6 text-ink outline-none focus:border-purple focus:ring-2 focus:ring-purple/25"
            />
            <p class="demo-error mt-1.5 hidden text-sm text-[#f2545b]" role="alert">Please enter a valid business email.</p>
            <button
              type="submit"
              class="mt-6 w-full rounded bg-yellow px-6 py-4 text-base font-[800] uppercase leading-[18px] tracking-[1.6px] text-ink transition hover:brightness-95"
            >Pick your time</button>
            <p class="mt-4 text-center text-sm leading-[18px] text-[#b3b3b3]">Heymarket is currently available in the US and Canada.</p>
            <p class="demo-status mt-2 hidden text-center text-sm leading-[18px] text-ink-70" role="status"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- Customer logos -->
    <section class="py-12" aria-label="Customers">
      <ul class="mx-auto flex max-w-[1110px] flex-wrap items-center justify-center gap-x-12 gap-y-6 px-5 lg:justify-between lg:px-[46px]">
        {logos.map((l) => (
          <li><img src={l.src} alt={l.alt} width={l.w / 2} height="70" class="h-[50px] w-auto lg:h-[70px]" /></li>
        ))}
      </ul>
    </section>

    <!-- Proof: U-Haul stat + quote -->
    <section class="bg-[#e1d7fb] py-[60px]" aria-label="Customer result">
      <div class="mx-auto max-w-[1110px] px-5 lg:px-0">
        <figure class="grid items-center gap-8 rounded-[40px] bg-paper p-8 shadow-[0_16px_50px_0_rgba(0,0,0,0.1)] sm:p-[60px] md:grid-cols-[225px_1fr] md:gap-12">
          <div class="text-center">
            <p class="text-[clamp(4rem,2.5rem+4vw,6.25rem)] font-[800] leading-none text-blue">60%</p>
            <p class="mt-2 text-lg font-semibold leading-[27px]">response rate achieved</p>
          </div>
          <div>
            <img src={`${A}/demo-quote-uhaul.webp`} alt="U-Haul" width="115" height="66" class="h-auto w-[115px]" />
            <blockquote class="mt-2 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-semibold leading-[1.2]">
              “Heymarket’s Salesforce SMS integration makes messaging leads and customers a
              <span class="text-blue">smooth experience</span> for our agents.”
            </blockquote>
          </div>
        </figure>
      </div>
    </section>

    <!-- Customer stories -->
    <section class="bg-beige py-[50px]" aria-labelledby="stories-heading">
      <div class="mx-auto max-w-[1110px] px-5 lg:px-0">
        <h2 id="stories-heading" class="mx-auto max-w-[900px] text-center text-[length:var(--text-h3)] font-[800] leading-[1.2]">
          In the meantime, check out how some of our customers are connecting with their customers with Heymarket
        </h2>
        <div class="mt-10 grid gap-12 md:grid-cols-3 md:gap-[30px] lg:gap-[60px]">
          {stories.map((s) => (
            <article class="story-card relative flex flex-col bg-paper px-8 pb-16 pt-[58px]">
              <span class="story-tag" style={`background:${s.tagBg}`}>{s.tag}</span>
              <img src={s.logo} alt={s.logoAlt} width={s.logoW} height={s.logoH} class="h-auto self-start" style={`width:${s.logoW}px`} />
              <p class="mt-4 text-[56px] font-[800] leading-[1.2]" style={`color:${s.statColor}`}>{s.stat}</p>
              <p class="mt-1 text-base font-semibold leading-6">{s.label}</p>
              <p class="mt-4 flex-1 text-base leading-6">“{s.quote}”</p>
              <a href="#" class="group mt-8 inline-flex items-center gap-1 text-base font-semibold leading-6 text-blue">
                Read the story
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-purple py-20 text-center text-paper" aria-labelledby="demo-cta-heading">
      <h2 id="demo-cta-heading" class="px-5 text-[length:var(--text-h2)] font-[800] leading-[1.2]">Grow connections and conversions</h2>
      <a
        href="#book-demo"
        class="mt-8 inline-block rounded bg-yellow px-6 py-4 text-base font-[800] uppercase leading-[18px] text-ink transition hover:brightness-95"
      >Book a demo</a>
    </section>
  </main>

  <!-- Minimal footer -->
  <footer class="bg-ink p-6 text-base leading-6 text-[#b3b3b3]">
    <div class="mx-auto flex max-w-[1110px] flex-wrap items-center justify-center gap-x-16 gap-y-3">
      <div class="flex gap-6">
        <a href="https://www.heymarket.com/tos/" class="hover:text-paper">Terms of Service</a>
        <a href="https://www.heymarket.com/privacy/" class="hover:text-paper">Privacy Policy</a>
      </div>
      <p>© {new Date().getFullYear()} Common Sun, Inc.</p>
      <div class="flex gap-6">
        <a href="sms:+14155620500" class="inline-flex items-center gap-2 hover:text-paper">
          <img src={`${A}/demo-footer-chat.svg`} alt="" width="23" height="17" /> (415) 562-0500
        </a>
        <a href="mailto:sales@heymarket.com" class="inline-flex items-center gap-2 hover:text-paper">
          <img src={`${A}/demo-footer-email.svg`} alt="" width="24" height="24" /> sales@heymarket.com
        </a>
      </div>
    </div>
  </footer>
</Base>

<style>
  /* Big rounded hero: 140px corners except a tight bottom-right, like the site. */
  .demo-hero {
    border-radius: clamp(40px, 10vw, 140px) clamp(40px, 10vw, 140px) 10px clamp(40px, 10vw, 140px);
  }
  /* Speech-bubble story card with a tab label hanging off its top-right. */
  .story-card {
    border-radius: 40px 40px 8px 40px;
    box-shadow: 0 16px 50px 0 rgb(0 0 0 / 0.1);
  }
  .story-tag {
    position: absolute;
    top: 0;
    right: -30px;
    width: 230px;
    padding: 8px 12px;
    border-radius: 16px 16px 16px 2px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-transform: uppercase;
    color: var(--color-ink-70);
  }
  @media (max-width: 767px) {
    .story-tag { right: 16px; width: auto; }
  }
</style>

<script>
  // Preview-only form: validate the email locally. Not connected to HubSpot or
  // the scheduler, so nothing is submitted or stored.
  const form = document.querySelector<HTMLFormElement>(".demo-form");
  const email = document.getElementById("demo-email") as HTMLInputElement | null;
  const error = form?.querySelector<HTMLElement>(".demo-error");
  const status = form?.querySelector<HTMLElement>(".demo-status");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!email || !error || !status) return;
    const ok = email.checkValidity();
    error.classList.toggle("hidden", ok);
    email.setAttribute("aria-invalid", String(!ok));
    status.classList.toggle("hidden", !ok);
    status.textContent = ok ? "Preview only: this form isn’t connected yet, so nothing was sent." : "";
    if (!ok) email.focus();
  });
</script>
