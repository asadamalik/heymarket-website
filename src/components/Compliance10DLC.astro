---
const cards = [
  "/heymarket-website/assets/card-10dlc-1.webp",
  "/heymarket-website/assets/card-10dlc-2.webp",
  "/heymarket-website/assets/card-10dlc-3.webp",
];
const steps = [
  "Text-enable your business phone number",
  "Get support on 10DLC registration",
  "Stay compliant with opt-in and security guidance",
];
---
<section class="bg-ink py-[var(--space-section)] text-paper" aria-labelledby="compliance-heading">
  <div class="container-x text-center">
    <h2
      id="compliance-heading"
      class="mx-auto max-w-3xl text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)] tracking-[-0.01em]"
    >
      Register for 10DLC quickly and stay compliant
    </h2>

    <div class="mx-auto mt-12 grid max-w-[1080px] gap-6 sm:grid-cols-3">
      {cards.map((c, i) => (
        <img
          src={c}
          alt={`Step ${i + 1}: business phone number registration for 10DLC`}
          width="338"
          height="184"
          loading="lazy"
          class="h-auto w-full"
        />
      ))}
    </div>

    <ol class="relative mx-auto mt-10 grid max-w-[960px] grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6">
      <span aria-hidden="true" class="absolute left-[16.66%] right-[16.66%] top-4 hidden h-px bg-yellow/40 sm:block"></span>
      {steps.map((s, i) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-yellow text-sm font-bold text-ink">{i + 1}</span>
          <p class="mt-4 max-w-[15rem] font-bold leading-snug">{s}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12">
      <a
        href="#"
        class="inline-block rounded-lg bg-yellow px-8 py-4 text-[13px] font-bold uppercase tracking-wide text-ink transition-transform hover:-translate-y-0.5 hover:bg-yellow-70"
      >Get Started</a>
    </div>
  </div>
</section>
