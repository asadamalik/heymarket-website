---
// Animated agentic conversation (Maria Chen · Scheduling Agent).
// Steps 1–2 are shown immediately; the rest reveal in sequence on load.
const avatar = "/heymarket-website/assets/avatar-sadie.webp";
---
<div class="relative mx-auto w-full max-w-[560px] lg:mr-0 lg:max-w-[600px]">
  <!-- Purple panel peeking behind -->
  <div
    aria-hidden="true"
    class="absolute inset-0 rounded-[30px] bg-gradient-to-br from-purple to-blue-70"
    style="transform: translate(-16px, -30px)"
  ></div>

  <!-- Window control dots on the purple bar -->
  <div class="absolute -top-[17px] left-[15px] z-10 flex gap-2" aria-hidden="true">
    <span class="h-[10px] w-[10px] rounded-full bg-white"></span>
    <span class="h-[10px] w-[10px] rounded-full bg-white"></span>
    <span class="h-[10px] w-[10px] rounded-full bg-white"></span>
  </div>

  <!-- Window -->
  <div class="relative overflow-visible rounded-[28px] bg-white shadow-2xl">
    <div class="rounded-[28px] border-2 border-black bg-white px-5 pt-5 pb-6 sm:px-6">
      <!-- Header -->
      <div class="flex items-center justify-between gap-2 pb-4">
        <div class="flex items-center gap-2">
          <span class="text-[15px] font-bold text-ink sm:text-base">Maria Chen</span>
          <img src="/heymarket-website/assets/sms.svg" alt="SMS" width="20" height="20" class="h-5 w-5" />
        </div>
        <div class="flex items-center gap-1.5 text-[13px] sm:text-sm">
          <span class="text-grey-75">Assignee:</span>
          <span class="font-bold text-purple">Scheduling Agent</span>
          <img src="/heymarket-website/assets/hey-ai.svg" alt="" width="18" height="18" class="h-4 w-4" />
        </div>
      </div>
      <div class="-mx-5 border-t border-black/10 sm:-mx-6"></div>

      <!-- Conversation (fixed-height live-chat viewport; track slides up smoothly) -->
      <div class="chat-scroll">
        <div class="chat-track text-[14px] sm:text-[15px]">
        <!-- 1 · inbound (shown) -->
        <div class="flex items-end gap-2.5">
          <img src={avatar} alt="" width="36" height="36" class="h-8 w-8 shrink-0 rounded-full object-cover" />
          <div class="rounded-2xl rounded-bl-md bg-grey-f5 px-4 py-2.5 text-ink">Hello, do I need a referral to book an appointment?</div>
          <span class="whitespace-nowrap self-center text-xs text-grey-75">4:08 pm</span>
        </div>

        <!-- 2 · outbound Q&A Agent (shown) -->
        <div class="flex flex-col items-end gap-1">
          <span class="pr-1 text-[13px] font-bold text-purple">Q&A Agent</span>
          <div class="flex items-end justify-end gap-2.5">
            <span class="whitespace-nowrap self-center text-xs text-grey-75">4:12 am</span>
            <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gradient-to-br from-purple to-blue px-4 py-3 leading-snug text-white shadow-[0_10px_36px_-6px_rgba(93,63,211,0.75)]">
              Hi Maria, with your plan, you don't need a referral.
            </div>
          </div>
        </div>

        <!-- 3 · inbound -->
        <div class="step" data-step="0.9">
          <div class="flex items-end gap-2.5">
            <img src={avatar} alt="" width="36" height="36" class="h-8 w-8 shrink-0 rounded-full object-cover" />
            <div class="rounded-2xl rounded-bl-md bg-grey-f5 px-4 py-2.5 text-ink">Do you have openings on Tuesday morning?</div>
            <span class="whitespace-nowrap self-center text-xs text-grey-75">9:04 am</span>
          </div>
        </div>

        <!-- 4 · AI agent -->
        <div class="step" data-step="2.1">
          <div class="flex flex-col items-end gap-1">
            <span class="pr-1 text-[13px] font-bold text-purple">Scheduling Agent</span>
            <div class="flex items-end justify-end gap-2.5">
              <span class="whitespace-nowrap self-center text-xs text-grey-75">9:04 am</span>
              <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gradient-to-br from-purple to-blue px-4 py-3 leading-snug text-white shadow-[0_10px_36px_-6px_rgba(93,63,211,0.75)]">
                Dr. Lee is available at 10 am. Sending you a calendar hold now.
              </div>
            </div>
          </div>
        </div>

        <!-- 5 · RCS calendar card — width matches the AI Agent bubble above -->
        <div class="step" data-step="3.4">
          <div class="ml-auto max-w-[80%]">
            <div class="rounded-2xl border border-black/10 p-3 shadow-sm">
              <div class="flex items-start gap-3">
                <div class="shrink-0 overflow-hidden rounded-xl text-center">
                  <div class="bg-blue px-3 pt-1 text-[11px] font-semibold uppercase tracking-wide text-white">Aug</div>
                  <div class="bg-grey-f5 px-3 pb-1 pt-0.5 text-2xl font-extrabold leading-tight text-ink">20</div>
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-ink">Heymarket walkthrough · 30 min</p>
                  <p class="mt-0.5 text-[13px] text-ink-70">Thu, Aug 20 · 10:30 AM PT</p>
                  <p class="text-[13px] text-grey-75">Video call · Dana R. + 1</p>
                </div>
              </div>
              <div class="mt-3 rounded-xl bg-grey-f5 px-3 py-2 text-center text-[13px] text-ink-70">
                Maria can <span class="font-bold text-ink">add to calendar</span> or <span class="font-bold text-ink">pick another time</span>
              </div>
            </div>
            <p class="mt-1.5 pr-1 text-right text-xs text-grey-75">RCS · Calendar invitation</p>
          </div>
        </div>

        <!-- 6 · invitation accepted -->
        <div class="step" data-step="5.6">
          <div class="flex items-center justify-end gap-1.5">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#22b95e]" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-[13px] font-bold text-[#22b95e]">Invitation Accepted • 9:05am</span>
          </div>
        </div>
        </div>
        <div class="chat-fade" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <!-- Floating: email notification — appointment confirmed (Figma 2821-6300) -->
  <div
    class="anim absolute -bottom-8 -left-[50px] hidden w-[240px] flex-col items-center gap-2 rounded-[23px] border border-[#e9e9e9] bg-white p-4 text-center shadow-2xl lg:flex"
    data-reveal="4.6"
  >
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-yellow">
      <!-- Figma email glyph (node 2821-6301), solid envelope in black -->
      <svg viewBox="0 0 24.6753 18.5065" class="w-[22px] text-black" fill="currentColor" aria-hidden="true">
        <path d="M24.5377 2.75788C24.6274 3.08017 24.6753 3.41982 24.6753 3.77062V14.7359C24.6753 16.8175 22.9879 18.5065 20.9055 18.5065H3.76984C1.68781 18.5065 0 16.8187 0 14.7367V3.76984C0 3.41925 0.047858 3.07984 0.137398 2.75778L10.8103 11.5689C11.697 12.3008 12.9783 12.3008 13.8649 11.5689L24.5377 2.75788Z" />
        <path d="M23.4505 0.989022L12.5558 9.98313C12.4292 10.0877 12.2461 10.0877 12.1194 9.98313L1.22462 0.98888C1.89528 0.374738 2.7888 0 3.76984 0H20.9055C21.8865 0 22.7799 0.374854 23.4505 0.989022Z" />
      </svg>
    </span>
    <div class="flex flex-col items-center gap-1">
      <p class="text-base font-bold leading-none text-black">Appointment Confirmed</p>
      <div class="text-[13px] leading-[19px] text-[#4d4d4d]">
        <p class="whitespace-nowrap font-bold">Thu, Aug 20 • 10:30 AM PT</p>
        <p>is booked with Dr. Lee</p>
      </div>
    </div>
  </div>

  <!-- Floating: replied-in-4s badge (top-right) -->
  <div
    class="anim-badge absolute top-[88px] right-2 flex items-center gap-1.5 rounded-full border border-[#e6e6e6] bg-white px-4 py-2 shadow-[0_8px_28px_-4px_rgba(0,0,0,0.18)] sm:-right-[44px]"
    data-reveal="2.7"
  >
    <img src="/heymarket-website/assets/hey-ai.svg" alt="" width="18" height="18" class="h-4 w-4" />
    <span class="text-[13px] font-bold text-purple sm:text-sm">Replied in 4 seconds</span>
  </div>
</div>

<style>
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes badgeIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes msgIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  /* Floating cards reveal (and fade back out at loop restart) via transitions. */
  .anim,
  .anim-badge {
    opacity: 0;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .anim { transform: translateY(16px) scale(0.98); }
  .anim-badge { transform: translateY(-8px) scale(0.9); }
  .anim.show,
  .anim-badge.show { opacity: 1; transform: none; }

  /* Live-chat viewport: the track slides up smoothly to keep the newest message pinned. */
  .chat-scroll {
    position: relative;
    height: 320px;
    /* Clip only the top (older messages exit) while letting bubble glows breathe on the sides/bottom. */
    clip-path: inset(0 -20px -24px -20px);
    transition: opacity 0.45s ease;
  }
  .chat-scroll.fade-out { opacity: 0; }
  .chat-fade {
    position: absolute;
    inset: 0 0 auto 0;
    height: 34px;
    background: linear-gradient(to bottom, #fff, rgba(255, 255, 255, 0));
    z-index: 5;
    pointer-events: none;
  }
  .chat-track {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.25rem;
    will-change: transform;
  }
  .chat-track.animate {
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* A queued message takes no space until revealed, then fades in as the track glides up. */
  .step { display: none; }
  .step.show { display: block; animation: msgIn 0.65s ease both; }

  @media (prefers-reduced-motion: reduce) {
    .anim,
    .anim-badge {
      opacity: 1 !important;
      animation: none !important;
      transform: none !important;
    }
    .chat-scroll { height: auto; clip-path: none; }
    .chat-fade { display: none; }
    .chat-track { transform: none !important; transition: none !important; }
    .step { display: block !important; animation: none !important; }
  }
</style>

<script>
  // Play the agentic conversation on a loop: reveal each step/float on schedule,
  // sliding the track up to keep the newest message pinned, then reset and replay.
  const scroll = document.querySelector(".chat-scroll");
  const track = document.querySelector(".chat-track");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (scroll instanceof HTMLElement && track instanceof HTMLElement && !reduce) {
    const steps = Array.from(track.querySelectorAll<HTMLElement>(".step"));
    const floats = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

    const pin = () => {
      track.style.transform = `translateY(${scroll.clientHeight - track.scrollHeight}px)`;
    };

    // Reveal-cadence multiplier: >1 lengthens the pause between each interaction
    // (the bubble's own fade/slide speed is unchanged — only the gaps grow).
    const RATE = 1.8;
    const events = [
      ...steps.map((el) => ({ el, t: parseFloat(el.dataset.step || "0") * 1000 * RATE, grows: true })),
      ...floats.map((el) => ({ el, t: parseFloat(el.dataset.reveal || "0") * 1000 * RATE, grows: false })),
    ];
    const HOLD = 3200; // pause on the finished conversation before fading out
    const FADE = 450; // cross-fade duration at the loop boundary
    const endT = Math.max(...events.map((e) => e.t)) + HOLD + FADE;

    let timers: number[] = [];

    const play = () => {
      // Reset to the start (messages hidden, floats hidden, track snapped) while faded.
      timers.forEach((id) => clearTimeout(id));
      timers = [];
      steps.forEach((s) => s.classList.remove("show"));
      floats.forEach((f) => f.classList.remove("show"));
      track.classList.remove("animate");
      pin();
      void track.offsetHeight;
      track.classList.add("animate");
      scroll.classList.remove("fade-out"); // fade the fresh conversation in

      // Reveal each step / float on schedule.
      for (const ev of events) {
        timers.push(
          window.setTimeout(() => {
            ev.el.classList.add("show");
            if (ev.grows) requestAnimationFrame(() => requestAnimationFrame(pin));
          }, ev.t)
        );
      }

      // Fade the finished conversation out just before restarting.
      timers.push(
        window.setTimeout(() => {
          scroll.classList.add("fade-out");
          floats.forEach((f) => f.classList.remove("show"));
        }, endT - FADE)
      );
      timers.push(window.setTimeout(play, endT));
    };

    pin();
    requestAnimationFrame(() => {
      track.classList.add("animate");
      play();
    });
  }
</script>
