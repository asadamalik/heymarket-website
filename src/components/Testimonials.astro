---
const items = [
  {
    featured: false,
    title: "The best tool for team messaging",
    body: "You can reach out to potential new contacts, and it has all the bells and whistles over the competitors. With one account, you can set up templates and automations. We haven't had any issues training our team and they're really receptive to feedback about the product.",
    author: "M. Rivera",
    role: "Operations",
  },
  {
    featured: true,
    title: "Awesome App with tons of features and support",
    body: "Heymarket is the perfect app to compliment our business. Took our business to the next level and we now can't see ourselves without it. Our clients have another method of reaching us, it's fast, intuitive, and has a load of features (templates, campaigns, automations) available.",
    author: "Z. Alyasiry",
    role: "",
  },
  {
    featured: false,
    title: "Amazing support and service",
    body: "I had a fantastic experience with Heymarket. The platform is simply outstanding and top notch, and I wholeheartedly recommend it as a business messaging solution.",
    author: "T. Clarkson",
    role: "Healthcare",
  },
];
---
<section class="overflow-hidden bg-beige py-[var(--space-section)]" aria-labelledby="testimonials-heading">
  <div class="container-x text-center">
    <h2
      id="testimonials-heading"
      class="text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)] tracking-[-0.01em]"
    >
      Trusted by thousands of businesses
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-ink-70">
      Companies choose our business text messaging service for its powerful, intuitive features. We
      have the badges to prove it, but more importantly, here's what our customers have to say.
    </p>
  </div>

  <div class="mt-12">
    <div
      id="testimonial-carousel"
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-[max(1.5rem,calc((100%-760px)/2))] pb-4 [-ms-overflow-style:none] [scrollbar-width:none]"
    >
      {items.map((t) => (
        <article
          data-featured={t.featured ? "" : null}
          class={`flex min-w-[min(760px,85vw)] snap-center flex-col rounded-3xl p-8 text-left sm:p-10 ${
            t.featured ? "bg-blue-70 text-paper" : "bg-purple-70/45 text-blue"
          }`}
        >
          <div class={`flex gap-1 ${t.featured ? "text-paper" : "text-blue/60"}`}>
            {[0, 1, 2, 3, 4].map(() => (
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                <path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z" />
              </svg>
            ))}
          </div>
          <h3 class="mt-5 text-2xl font-bold leading-snug">{t.title}</h3>
          <p class={`mt-4 text-[16px] leading-relaxed ${t.featured ? "text-paper/90" : "text-blue/80"}`}>{t.body}</p>
          <p class="mt-6 text-sm font-bold">
            {t.author}{t.role && <span class="font-medium">, {t.role}</span>}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-8 flex justify-center gap-2" aria-hidden="true">
      <span class="h-2 w-2 rounded-full bg-ink/25"></span>
      <span class="h-2 w-6 rounded-full bg-ink"></span>
      <span class="h-2 w-2 rounded-full bg-ink/25"></span>
    </div>
  </div>
</section>

<script>
  // Center the featured testimonial on load (no animation).
  const car = document.getElementById("testimonial-carousel");
  const feat = car?.querySelector<HTMLElement>("[data-featured]");
  if (car && feat) {
    const centre = feat.offsetLeft - (car.clientWidth - feat.clientWidth) / 2;
    car.scrollLeft = Math.max(0, centre);
  }
</script>
