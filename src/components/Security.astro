---
---
<section class="bg-paper py-[var(--space-section)]" aria-labelledby="security-heading">
  <div class="container-x">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <h2
          id="security-heading"
          class="text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)] tracking-[-0.01em]"
        >
          Securing 500 million+ messages
        </h2>
        <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-70">
          Strong relationships are built on trust. Heymarket offers enterprise-grade security on a
          SOC 2 Type 2, TCPA, and HIPAA compliant platform. Customize roles and permissions to
          secure your team's access.
        </p>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src="/heymarket-website/assets/mock-security.webp"
          alt="Compliance badges: SOC 2 Type 2 report seal and a HIPAA health caduceus symbol."
          width="766"
          height="540"
          loading="lazy"
          class="h-auto w-full max-w-[520px]"
        />
      </div>
    </div>
  </div>
</section>
