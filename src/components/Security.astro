---
---
<section class="bg-paper py-[var(--space-section)]" aria-labelledby="security-heading">
  <div class="container-x">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <h2
          id="security-heading"
          class="text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)]"
        >
          Securing 500 million+ messages
        </h2>
        <p class="mt-6 max-w-lg text-base leading-6 text-ink">
          Strong relationships are built on trust. Heymarket offers enterprise-grade security on a
          SOC 2 Type 2, TCPA, and HIPAA compliant platform. Customize roles and permissions to
          secure your team's access.
        </p>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src="/heymarket-website/assets/security-badges.webp"
          alt="Compliance badges: AICPA SOC report seal and the HIPAA (Health Insurance Portability and Accountability Act) logo."
          width="900"
          height="304"
          loading="lazy"
          class="h-auto w-full max-w-[520px]"
        />
      </div>
    </div>
  </div>
</section>
