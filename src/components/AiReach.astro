---
// "Reduce manual work with AI agents" — the three Heymarket AI agents.
// Copy and icons sourced from heymarket.com.
type Agent = { name: string; icon: string; iconW: number; iconH: number; iconPad?: boolean; body: string; points: string[] };
const agents: Agent[] = [
  {
    name: "Q&A Agent",
    icon: "/heymarket-website/assets/icon-agent-qa.svg",
    iconW: 84,
    iconH: 44,
    iconPad: true, // artwork runs edge-to-edge; inset it within the 60px box
    body: "Answers FAQs instantly from your approved knowledge base. Works across all your messaging channels and gets smarter every day.",
    points: ["Handles 200+ questions/day", "Leverages your knowledge base", "Cites every source"],
  },
  {
    name: "Scheduling Agent",
    icon: "/heymarket-website/assets/icon-agent-scheduling.svg",
    iconW: 85,
    iconH: 85,
    body: "Books, reschedules, and cancels appointments via text. Detects intent, presents available slots, and sends confirmations automatically.",
    points: ["Books across any channel", "Handles cancellations & reschedules", "Sends calendar confirmations"],
  },
  {
    name: "Lead Enrichment Agent",
    icon: "/heymarket-website/assets/icon-agent-enrichment.svg",
    iconW: 63,
    iconH: 66,
    body: "Extracts and enriches lead data from every conversation — name, company, intent, budget, timeline — and syncs it to your CRM.",
    points: ["Auto-fills CRM fields", "Detects intent and extracts data", "Tags and scores leads"],
  },
];
---
<section class="ai-section py-[var(--space-section)] text-paper" aria-labelledby="ai-heading">
  <div class="container-x text-center">
    <h2
      id="ai-heading"
      class="mx-auto max-w-4xl text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)]"
    >
      Reduce manual work with AI agents
    </h2>
    <p class="mx-auto mt-5 max-w-3xl text-base leading-6 text-paper">
      Our specialized agents work alongside your team in your shared inbox to speed up response
      times, schedule meetings, and enrich data to reduce manual work.
    </p>

    <div class="mx-auto mt-14 grid max-w-[1120px] gap-10 text-left md:grid-cols-3 md:gap-8">
      {agents.map((a) => (
        <article class="agent-card">
          <img src={a.icon} alt="" width={a.iconW} height={a.iconH} class={`h-[60px] w-auto ${a.iconPad ? "py-[5px]" : ""}`} />
          <h3 class="mt-5 text-lg font-[800] leading-[1.2] md:text-xl text-blue">{a.name}</h3>
          <p class="mt-3 text-base leading-6 text-ink">{a.body}</p>
          <ul class="mt-5 space-y-2">
            {a.points.map((p) => (
              <li class="flex gap-2.5 text-[14px] font-semibold leading-[21px] text-ink">
                <span class="agent-dot" aria-hidden="true"></span>
                {p}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-16">
      <a
        href="#"
        class="inline-block rounded-lg bg-green px-7 py-4 text-base font-[800] uppercase leading-[18px] text-ink transition-transform hover:-translate-y-0.5 hover:brightness-95"
      >Explore all AI agents</a>
    </div>
  </div>
</section>

<style>
  .ai-section {
    background-image: linear-gradient(100deg, #000 0%, var(--color-blue) 92%);
  }
  .agent-card {
    background: #fff;
    border: 1px solid #000;
    /* Speech-bubble shape: one tight corner, matching heymarket.com. */
    border-radius: 40px 40px 8px 40px;
    padding: 3.5rem 2rem 2rem;
    box-shadow: 10px 10px 0 0 var(--color-purple);
  }
  .agent-dot {
    flex-shrink: 0;
    margin-top: 0.45em;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-purple);
  }
</style>
