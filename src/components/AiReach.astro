---
const features = [
  {
    icon: "/heymarket-website/assets/icon-translate.webp",
    title: "Reach more people with translation",
    body: "Empower your team to help more people in more languages.",
  },
  {
    icon: "/heymarket-website/assets/icon-expand.webp",
    title: "Refine your texts and emails in one click",
    body: "Instantly correct, formalize, shorten and expand texts and emails to make them more effective.",
  },
  {
    icon: "/heymarket-website/assets/icon-suggested.webp",
    title: "Give quick, contextual answers",
    body: "Upload your knowledge base to generate hyper-personalized messages.",
  },
];
---
<section class="bg-purple py-[var(--space-section)] text-paper" aria-labelledby="ai-heading">
  <div class="container-x text-center">
    <svg viewBox="0 0 24 24" class="mx-auto h-9 w-9 text-paper" fill="currentColor" aria-hidden="true">
      <path d="M12 2l1.7 6.8L20 10l-6.3 1.2L12 18l-1.7-6.8L4 10l6.3-1.2z" />
      <path d="M19 3l.7 2.6L22 6l-2.3.4L19 9l-.7-2.6L16 6l2.3-.4z" opacity="0.8" />
    </svg>
    <h2
      id="ai-heading"
      class="mx-auto mt-5 max-w-4xl text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)] tracking-[-0.01em]"
    >
      Extend your reach with AI-assisted texting and email
    </h2>

    <div class="mt-14 grid gap-10 text-left sm:grid-cols-3 sm:gap-8">
      {features.map((f) => (
        <div>
          <img src={f.icon} alt="" width="56" height="56" class="h-12 w-12" />
          <h3 class="mt-4 text-lg font-bold leading-snug">{f.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-paper/85">{f.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <a
        href="#"
        class="inline-block rounded-lg bg-green px-7 py-4 text-[13px] font-bold uppercase tracking-wide text-ink transition-transform hover:-translate-y-0.5 hover:brightness-95"
      >Try our AI features</a>
    </div>
  </div>
</section>
