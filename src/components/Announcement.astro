---
// Top announcement bar
---
<div class="w-full bg-purple text-paper">
  <div class="container-x flex items-center justify-center gap-3 py-2.5 text-center text-[13px] sm:text-sm">
    <!-- Toggle glyph -->
    <span
      aria-hidden="true"
      class="hidden sm:inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-ink px-0.5"
    >
      <span class="grid h-5 w-5 place-items-center rounded-full bg-paper text-purple">
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true">
          <path d="M12 2l1.6 6.4L20 10l-6.4 1.6L12 18l-1.6-6.4L4 10l6.4-1.6z" />
        </svg>
      </span>
    </span>
    <p class="leading-tight">
      <span class="font-bold">Try it now!</span> Resolve 40% of conversations with AI agents
      <a href="#" class="ml-1 font-bold underline underline-offset-2 hover:text-yellow">Join the beta</a>
    </p>
  </div>
</div>
