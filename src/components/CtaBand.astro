---
<section class="bg-purple py-20 text-paper" aria-labelledby="cta-heading">
  <div class="container-x text-center">
    <h2
      id="cta-heading"
      class="mx-auto max-w-4xl text-[length:var(--text-h2)] font-[800] leading-[var(--text-h2--line-height)] tracking-[-0.01em]"
    >
      Tired of juggling tools? Centralize communication today.
    </h2>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#"
        class="inline-block rounded-lg bg-yellow px-8 py-4 text-[13px] font-bold uppercase tracking-wide text-ink transition-transform hover:-translate-y-0.5 hover:bg-yellow-70"
      >Book a Demo</a>
      <a
        href="#"
        class="group inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-wide text-paper"
      >
        Start Free Trial
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>
