---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Heymarket — One agentic inbox for your texts and emails",
  description = "Put AI agents to work across texting and email. Answer questions, schedule appointments, and route conversations automatically while your team stays in control from one secure, centralized inbox.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preload the two most critical weights (hero heading + body) -->
    <link
      rel="preload"
      href="/heymarket-website/fonts/sf-pro-display-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/heymarket-website/fonts/sf-pro-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
